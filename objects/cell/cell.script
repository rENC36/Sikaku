function init(self)
	self.x = 0
	self.y = 0
	self.number = nil
	self.selected = false
end

function on_message(self, message_id, message)
	if message_id == hash("set_data") then
		self.x = message.x
		self.y = message.y
		self.number = message.number

		if self.number then
			label.set_text("#label", tostring(self.number))
		else
			label.set_text("#label", "")
		end

	elseif message_id == hash("set_color") then
