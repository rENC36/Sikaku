local BoardView = require("game.view.board_view")
local Selection = require("game.shikaku.selection")
local Input = require("game.shikaku.input")
local Solver = require("game.shikaku.solver")
local Board = require("game.shikaku.board")
local Levels = require("game.shikaku.levels.levels")
local PlayerData = require("game.player.player_data")

function init(self)
	msg.post(".", "acquire_input_focus")

	self.screens = {
		menu           = "/menu",
		mode_select    = "/mode_select",
		game           = "/game",
		classic_select = "/classic_select"
	}

	open_screen(self, "menu")
	self.game_active = false
	self.current_mode = nil
	self.current_level = 1
end

function on_message(self, message_id, message, sender)
	if message_id == hash("open_mode_select") then
		open_screen(self, "mode_select")

	elseif message_id == hash("start_game") then
		self.current_mode = message.mode or "classic"
		self.current_level = message.level or 1

		Levels.set_level("easy", self.current_level)

		open_screen(self, "game")
		load_puzzle_from_levels(self, "easy")

		msg.post(".", "acquire_input_focus")
		self.game_active = true

	elseif message_id == hash("back_to_menu") then
		if self.board_view then
			self.board_view:Clear()
		end
		self.board = nil
		self.input = nil
		self.selection = nil
		self.board_view = nil
		self.current_mode = nil
		self.current_level = 1

		open_screen(self, "menu")
		self.game_active = false

	elseif message_id == hash("open_leaderboard") then
		print("LEADERBOARD (TODO)")
	elseif message_id == hash("open_classic_levels") then
		open_screen(self, "classic_select")
	end
end

function on_input(self, action_id, action)
	if not self.game_active or not self.input then
		return
	end

	if action_id == hash("touch") then
		if action.pressed then
			self.input:MousePressed(action.x, action.y)
		elseif action.released then
			self.input:MouseReleased(action.x, action.y)

			if self.board:IsFull() then
				local rectangles = self.board:GetAllRectangles()
				if Solver.Check(self.board, rectangles) then
					print("SOLVED! Mode:", self.current_mode, "Level:", self.current_level)
					PlayerData.complete_level("easy", self.current_level)

					self.current_level = self.current_level + 1
					if self.current_level > Levels.count("easy") then
						self.current_level = 1
					end

					Levels.set_level("easy", self.current_level)
					load_puzzle_from_levels(self, "easy")
				else
					print("WRONG!")
				end
			end
		end
	end

	if action.x and action.y then
		self.input:MouseMoved(action.x, action.y)
	end
end

function load_puzzle_from_levels(self, category)
	if self.board_view then
		self.board_view:Clear()
	end

	local puzzle = Levels.load(category)
	if not puzzle then
		print("NO PUZZLE FOUND")
		return
	end

	self.board = Board.new(puzzle.width, puzzle.height)

	for y = 1, puzzle.height do
		for x = 1, puzzle.width do
			local number = puzzle.data[y][x]
			if number and number ~= 0 then
				self.board:GetCell(x, y):SetNumber(number)
			end
		end
	end

	self.board_view = BoardView.new("/Factories#cellfactory", {
		cell_size = 64,
		spacing = 32,
		start_position = vmath.vector3(100, 300, 0)
	})
	self.board_view:Create(self.board)

	self.selection = Selection.new(self.board)
	self.input = Input.new(self.selection, self.board_view)

	print("LOADED:", category, "puzzle #", (Levels.index[category] or 1) - 1)
end

function open_screen(self, name)
	local url = self.screens[name]
	if not url then
		print("ERROR: Unknown screen:", name)
		return
	end

	for _, u in pairs(self.screens) do
		msg.post(u, "disable")
	end

	msg.post(url, "reset_ui")
	msg.post(url, "enable")
	msg.post(url, "acquire_input_focus")

	print("SCREEN:", name)
end