local ScreenManager = require("utils.screen_manager")
local Audio         = require("utils.audio_manager")
local SoundCFG      = require("data.config.sounds")
local ClassicGame   = require("game.classic.classic_game")
local BlitzGame     = require("game.blitz.blitz_game")
local EndlessGame   = require("game.endless.endless_game")
local HintsManager  = require("utils.hints_manager")
local PlayerData    = require("game.player.player_data")
local PopupSystem   = require("utils.popup_system")

local yagames = require("yagames.yagames")

function init(self)
	Audio.init()
	Audio.SOUNDS = SoundCFG.SOUNDS or {}
	Audio.MUSICS = SoundCFG.MUSICS or {}

	self.screens = ScreenManager.new()
	self.screens:register("menu",           "/menu")
	self.screens:register("mode_select",    "/mode_select")
	self.screens:register("classic_select", "/classic_select")
	self.screens:register("game",           "/game")
	self.screens:register("blitz_game",     "/blitz_game")
	self.screens:register("endless_game",   "/endless_game")

	self.classic = ClassicGame.new()
	self.blitz   = BlitzGame.new()
	self.endless = EndlessGame.new()

	self.popup = PopupSystem.new()
	self.popup:register_gui("/popup#popup")

	self.screens:open("menu")
	Audio.play_music_id("menu")

	yagames.init()
	yagames.ysdk_ready()
end

local function start_blitz(self)
	self.blitz:cleanup()
	self.blitz:restart()
	self.blitz:start_timer(function(t, game_over)
		msg.post("/blitz_game", "update_hud", {
			timer = t,
			score = self.blitz.score,
			size  = self.blitz.grid_size,
			game_over = game_over,
		})
		if game_over then
			msg.post("/blitz_game", "show_game_over", { score = self.blitz.score })
		end
	end)
	msg.post("/blitz_game", "update_hud", {
		timer = self.blitz.timer,
		score = self.blitz.score,
		size  = self.blitz.grid_size,
		game_over = false,
	})
end

local function start_endless(self)
	self.endless:cleanup()
	self.endless:start()
	local best = PlayerData.get("stats.endless_best") or 0
	msg.post("/endless_game", "set_endless_best", {
		best = best,
		score_now = self.endless.score,
	})
end

local function update_endless_hud(self)
	if not self.endless then return end
	local best = PlayerData.get("stats.endless_best") or 0
	if self.endless.score > best then
		PlayerData.set("stats.endless_best", self.endless.score)
		PlayerData.save()
		best = self.endless.score
	end
	msg.post("/endless_game", "set_endless_best", {
		best = best,
		score_now = self.endless.score,
	})
end

function on_message(self, message_id, message, sender)
	if message_id == hash("popup_yes") then
		self.popup:on_button("yes")
		return
	elseif message_id == hash("popup_no") then
		self.popup:on_button("no")
		return

	elseif message_id == hash("open_popup") then
		self.popup:open(message.popup_type, message.params)

	elseif message_id == hash("open_popup_exit") then
		self.popup:open("exit_confirm")

	elseif message_id == hash("open_popup_hint") then
		local balance = HintsManager.GetBalance()
		if balance <= 0 then
			self.popup:open("no_hints")
		else
			self.popup:open("hint_confirm", { balance = balance })
		end
		
	elseif message_id == hash("open_popup_hint_endless") then
		local balance = HintsManager.GetBalance()
		if balance <= 0 then
			self.popup:open("no_hints")
		else
			self.popup:open("hint_confirm_endless", { balance = balance })
		end

	elseif message_id == hash("open_popup_hint_blitz") then
		local balance = HintsManager.GetBalance()
		if balance <= 0 then
			self.popup:open("no_hints")
		else
			self.popup:open("hint_confirm_blitz", { balance = balance })
		end

		
	elseif message_id == hash("open_mode_select") then
		self.screens:open("mode_select")

	elseif message_id == hash("open_classic_levels") then
		self.screens:open("classic_select")

	elseif message_id == hash("open_blitz_prepare") then
		self.screens:open("blitz_prepare")

	elseif message_id == hash("back_to_mode_select") then
		self.screens:open("mode_select")

	elseif message_id == hash("start_game") then
		local mode = message.mode or "classic"
		if mode == "blitz" then
			self.screens:open("blitz_game")
			start_blitz(self)
			Audio.play_music_id("game")
		elseif mode == "endless" then
			self.screens:open("endless_game")
			start_endless(self)
			Audio.play_music_id("game")
		else
			self.screens:open("game")
			self.classic:load_level(message.category, message.level)
			Audio.play_music_id("game")
		end

	elseif message_id == hash("back_to_menu") then
		self.classic:cleanup()
		self.blitz:cleanup()
		self.endless:cleanup()
		self.screens:open("menu")
		Audio.play_music_id("menu")

	elseif message_id == hash("open_leaderboard") then
		print("[Main] Leaderboard (TODO)")

	elseif message_id == hash("game_input") then
		if self.popup:pauses_input() then return end
		if self.classic then
			self.classic:on_input(message.action_id, message.action)
		end

	elseif message_id == hash("blitz_input") then
		if self.popup:pauses_input() then return end
		if self.blitz then
			local handled = self.blitz:on_input(message.action_id, message.action)
			if handled then
				msg.post("/blitz_game", "update_hud", {
					timer = self.blitz.timer,
					score = self.blitz.score,
					size  = self.blitz.grid_size,
					game_over = self.blitz.is_game_over,
				})
				if self.blitz.is_game_over then
					msg.post("/blitz_game", "show_game_over", { score = self.blitz.score })
				end
			end
		end

	elseif message_id == hash("endless_input") then
		if self.popup:pauses_input() then return end
		if self.endless then
			local handled = self.endless:on_input(message.action_id, message.action)
			if handled then
				update_endless_hud(self)
			end
		end

	elseif message_id == hash("use_hint") then
		local ok, reason = self.classic:use_hint()
		msg.post("/game", "update_hint_balance", { balance = HintsManager.GetBalance(), ok = ok, reason = reason })

	elseif message_id == hash("use_hint_endless") then
		local ok, reason = self.endless:use_hint()
		if ok then
			update_endless_hud(self)
		end
		msg.post("/endless_game", "update_hint_balance", { balance = HintsManager.GetBalance(), ok = ok, reason = reason })

	elseif message_id == hash("use_hint_blitz") then
		local ok, reason = self.blitz:use_hint()
		if ok then
			msg.post("/blitz_game", "update_hud", {
				timer = self.blitz.timer,
				score = self.blitz.score,
				size  = self.blitz.grid_size,
				game_over = self.blitz.is_game_over,
			})
		end
		msg.post("/blitz_game", "update_hint_balance", {
			balance = HintsManager.GetBalance(),
			ok = ok,
			reason = reason,
		})

	elseif message_id == hash("get_hint_balance") then
		msg.post(sender, "update_hint_balance", { balance = HintsManager.GetBalance() })
	end
end