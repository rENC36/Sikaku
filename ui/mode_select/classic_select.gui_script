local Anim = require("utils.animator")
local CFG = require("data.config.animations")
local PlayerData = require("game.player.player_data")
local Levels = require("game.shikaku.levels.levels")

local COLS = 5
local ROWS = 2
local PER_PAGE = COLS * ROWS
local GAP = 16

local ATLAS_NAME = "game"
local FRAME_NAME = "cell"
local CELL_SIZE = 100

function init(self)
	msg.post(".", "acquire_input_focus")

	self.category = "easy"
	self.total_levels = Levels.count(self.category)
	print("[ClassicSelect] Total levels:", self.total_levels)

	if self.total_levels == 0 then
		print("[ClassicSelect] WARNING: No levels found! Check levels.lua")
	end

	self.max_page = math.max(1, math.ceil(self.total_levels / PER_PAGE))
	self.page = PlayerData.get("last_page") or 1
	if self.page > self.max_page then self.page = self.max_page end
	if self.page < 1 then self.page = 1 end

	local cx = gui.get_width() / 2
	local cy = gui.get_height() / 2

	local grid_w = COLS * CELL_SIZE + (COLS - 1) * GAP
	local grid_h = ROWS * CELL_SIZE + (ROWS - 1) * GAP
	local start_x = cx - grid_w / 2 + CELL_SIZE / 2
	local start_y = cy + grid_h / 2 - CELL_SIZE / 2

	self.cells = {}
	for i = 1, PER_PAGE do
		local col = (i - 1) % COLS
		local row = math.floor((i - 1) / COLS)
		local x = start_x + col * (CELL_SIZE + GAP)
		local y = start_y - row * (CELL_SIZE + GAP)

		local box = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(CELL_SIZE, CELL_SIZE, 0))
		gui.set_pivot(box, gui.PIVOT_CENTER)
		gui.set_texture(box, ATLAS_NAME)
		gui.play_flipbook(box, FRAME_NAME)

		local text = gui.new_text_node(vmath.vector3(x, y, 0), "")
		gui.set_pivot(text, gui.PIVOT_CENTER)
		gui.set_font(text, "default")

		table.insert(self.cells, {
			box = box,
			text = text,
			level_num = 0,
		})
	end

	self.btn_back  = gui.get_node("btn_back")
	self.btn_left  = gui.get_node("btn_left")
	self.btn_right = gui.get_node("btn_right")

	self.buttons = Anim.register_buttons({
		{ node = "btn_back",  anim = CFG.btn_menu, action = function() msg.post("/main", "open_mode_select") end },
		{ node = "btn_left",  anim = CFG.btn_menu, action = function() change_page(self, -1) end },
		{ node = "btn_right", anim = CFG.btn_menu, action = function() change_page(self, 1) end },
	})

	refresh_grid(self)
	update_arrows(self)
end

function refresh_grid(self)
	local start_level = (self.page - 1) * PER_PAGE + 1
	local current_unlocked = PlayerData.get_current_level(self.category)

	for i, cell in ipairs(self.cells) do
		local level_num = start_level + (i - 1)
		cell.level_num = level_num

		if level_num > self.total_levels then
			gui.set_enabled(cell.box, false)
			gui.set_enabled(cell.text, false)
		else
			gui.set_enabled(cell.box, true)
			gui.set_enabled(cell.text, true)
			gui.set_text(cell.text, tostring(level_num))

			local completed = PlayerData.is_level_completed(self.category, level_num)

			if completed then
				gui.set_color(cell.box, vmath.vector4(0.2, 0.85, 0.3, 1))
				gui.set_color(cell.text, vmath.vector4(1, 1, 1, 1))
			elseif level_num <= current_unlocked then
				gui.set_color(cell.box, vmath.vector4(1, 1, 1, 1))
				gui.set_color(cell.text, vmath.vector4(0, 0, 0, 1))
			else
				gui.set_color(cell.box, vmath.vector4(0.25, 0.25, 0.25, 1))
				gui.set_color(cell.text, vmath.vector4(0.5, 0.5, 0.5, 1))
			end

			gui.set_scale(cell.box, vmath.vector3(1, 1, 1))
		end
	end
end

function update_arrows(self)
	gui.set_enabled(self.btn_left, self.page > 1)
	gui.set_enabled(self.btn_right, self.page < self.max_page)
end

function change_page(self, delta)
	local new_page = self.page + delta
	if new_page >= 1 and new_page <= self.max_page then
		self.page = new_page
		PlayerData.set("last_page", self.page)
		PlayerData.save()
		refresh_grid(self)
		update_arrows(self)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("reset_ui") then
		Anim.reset_buttons(self.buttons)
		refresh_grid(self)
		update_arrows(self)
	end
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") and action_id ~= nil then return false end
	if not action then return false end

	if Anim.handle_buttons(self.buttons, action_id, action) then
		return true
	end

	if action.pressed then
		for _, cell in ipairs(self.cells) do
			if gui.is_enabled(cell.box) and gui.pick_node(cell.box, action.x, action.y) then
				local current_unlocked = PlayerData.get_current_level(self.category)
				if cell.level_num <= current_unlocked then
					Anim.animate(cell.box, {
						scale = vmath.vector3(0.9, 0.9, 1),
						duration = 0.05,
						easing = gui.EASING_OUTQUAD,
						cancel = true,
					}, function()
						Anim.animate(cell.box, {
							scale = vmath.vector3(1, 1, 1),
							duration = 0.2,
							easing = gui.EASING_OUTBACK,
							cancel = true,
						})
						msg.post("/main", "start_game", {
							mode = "classic",
							category = self.category,
							level = cell.level_num,
						})
					end)
					return true
				end
			end
		end
	end

	return false
end