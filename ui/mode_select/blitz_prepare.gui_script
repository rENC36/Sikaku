local Anim       = require("utils.animator")
local CFG        = require("data.config.animations")
local PlayerData = require("game.player.player_data")
local Lang       = require("utils.localization")

function init(self)
	msg.post(".", "acquire_input_focus")

	local best = PlayerData.get("stats.blitz_best") or 0

	self.best_value      = gui.get_node("best_score_value")
	self.rules_text      = gui.get_node("rules_text")
	self.detailed_rules  = gui.get_node("detailed_rules")
	self.btn_start       = gui.get_node("btn_start")
	self.btn_back        = gui.get_node("btn_back")
	self.btn_rules       = gui.get_node("btn_rules")

	gui.set_text(self.best_value, tostring(best))
	gui.set_enabled(self.detailed_rules, false)

	Lang.apply_to_gui("blitz_prepare")

	self.buttons = Anim.register_buttons({
		{ node = "btn_start", anim = CFG.btn_start, sound = "click", action = function()
			msg.post("/main", "start_game", { mode = "blitz" })
		end },
		{ node = "btn_back",  anim = CFG.btn_menu, sound = "click", action = function()
			msg.post("/main", "back_to_mode_select")
		end },
		{ node = "btn_rules", anim = CFG.btn_menu, sound = "click", action = function()
			local visible = gui.is_enabled(self.detailed_rules)
			gui.set_enabled(self.detailed_rules, not visible)
		end },
	})
end

function on_input(self, action_id, action)
	return Anim.handle_buttons(self.buttons, action_id, action)
end