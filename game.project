[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 1920
height = 1080
high_dpi = 1
display_profiles = /builtins/render/default.display_profilesc

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0
cssfile = /builtins/manifests/web/light_theme.css

[project]
title = Sikaku

[label]
max_count = 1024

[sprite]
max_count = 1024

[render]
clear_color_blue = 1.0
clear_color_green = 0.973
clear_color_red = 0.969

